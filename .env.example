# =============================================
# GLOBE MEMORIES - FRONTEND CONFIGURAÇÃO
# =============================================

# API Backend URL
REACT_APP_API_URL=http://localhost:8080
REACT_APP_API_TIMEOUT=10000

# Ambiente
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_DEBUG=false

# Notificações
REACT_APP_NOTIFICATIONS_ENABLED=true

# Mapas
REACT_APP_LEAFLET_ATTRIBUTION=true

# Analytics (opcional)
REACT_APP_SENTRY_DSN=

# =============================================
# INSTRUÇÕES:
# 1. Copia este ficheiro para .env
# 2. Ajusta as variáveis conforme necessário
# 3. NÃO commit .env para git
# =============================================
